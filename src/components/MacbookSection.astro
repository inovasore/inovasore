---
import { Image } from "astro:assets";
// Import the image from the public folder or src/assets if it was there.
// Since the user said "imagen que esta en la carpeta public con el nombre Mackbook.webp",
// we can reference it directly as a string path in the src attribute of a standard img tag,
// or use Astro's Image component if we import it.
// However, files in `public` are not imported via ESM usually.
// Let's use a standard <img> tag for public folder assets or reference it as "/Mackbook.webp".
// The user wants to reuse DiscountBanner style.

const repeats = Array(12).fill(0);
---

<section class="macbook-section">
    <div class="macbook-container">
        <img
            src="/Mackbook.webp"
            alt="Macbook displaying website"
            class="macbook-img"
        />
    </div>

    <div class="ribbons-wrapper">
        <div class="ribbon ribbon--top">
            <div class="ribbon__track">
                {
                    repeats.map(() => (
                        <span class="ribbon__text">
                            <span class="text-highlight">
                                DESCUENTO DEL 30%
                            </span>
                            • HASTA EL 28 DE FEBRERO •
                        </span>
                    ))
                }
            </div>
        </div>

        <div class="ribbon ribbon--bottom">
            <div class="ribbon__track ribbon__track--reverse">
                {
                    repeats.map(() => (
                        <span class="ribbon__text">
                            <span class="text-highlight">
                                {" "}
                                • DESCUENTO DEL 30% •
                            </span>
                            HASTA EL 28 DE FEBRERO
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .macbook-section {
        position: relative;
        padding: 0 0 100px;
        /* Removed margin-top: -100px; */
        z-index: 10;
        /* Changed from hidden to visible */
        overflow: visible;
        /* Changed from linear-gradient to background-color */
        background-color: #ffffff;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .macbook-container {
        position: relative;
        z-index: 15; /* Above ribbons */
        width: 80%;
        max-width: 800px;
        /* Floating animation */
        animation: float 6s ease-in-out infinite;
        /* Overlap effect: Pull image up */
        margin-top: -40px;
    }

    /* Wrap ribbons to prevent horizontal scroll */
    .ribbons-wrapper {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        pointer-events: none;
        z-index: 12; /* Between background and image? Image is z-15. Background is parent. */
    }

    .macbook-img {
        width: 100%;
        height: auto;
        display: block;
        /* filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.4)); */
    }

    /* CINTAS Reutilizadas */
    .ribbon {
        position: absolute;
        left: -10%;
        width: 120%;
        height: 60px; /* Bit smaller maybe? */
        background: #1b56fd;
        overflow: hidden;
        display: flex;
        align-items: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        pointer-events: none; /* Let clicks pass through if needed */
    }

    .ribbon--top {
        top: auto;
        bottom: 8%; /* Center crossing */
        transform: rotate(-3deg);
        z-index: 20;
    }

    .ribbon--bottom {
        bottom: 8%; /* Same bottom */
        transform: rotate(3deg);
        z-index: 21; /* Slightly above to handle overlap clearly */
    }

    .ribbon__track {
        display: flex;
        white-space: nowrap;
        will-change: transform;
        animation: scroll-left 40s linear infinite; /* Slower */
    }

    .ribbon__track--reverse {
        animation: scroll-right 40s linear infinite;
    }

    .ribbon__text {
        font-size: var(--text-h3);
        font-weight: 900;
        color: #ffffff;
        padding: 0 15px;
        white-space: nowrap;
        display: flex;
        gap: 0.3em;
        text-transform: uppercase;
        /* Cinta en mayúsculas: conserva su espaciado propio */
        letter-spacing: 0.08em;
    }

    .text-highlight {
        color: #000000;
    }

    @keyframes scroll-left {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    @keyframes scroll-right {
        0% {
            transform: translateX(-50%);
        }
        100% {
            transform: translateX(0);
        }
    }

    @keyframes float {
        0% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
        100% {
            transform: translateY(0px);
        }
    }

    @media (max-width: 768px) {
        .macbook-section {
            padding: 60px 0;
        }

        .ribbon {
            width: 150%;
            left: -25%;
        }

        .ribbon--top {
            bottom: 15%;
        }

        .ribbon--bottom {
            bottom: 5%;
        }
    }
</style>
