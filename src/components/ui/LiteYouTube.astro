---
/**
 * Video de YouTube "ligero": solo muestra la portada (optimizada con
 * astro:assets) y un botón de play. El iframe se crea al hacer clic, así
 * la página no carga nada de YouTube hasta que el visitante lo pide.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  videoId: string;
  title?: string;
  params?: string;
  poster: ImageMetadata;
  sizes?: string;
}

const {
  videoId,
  title = "Video de YouTube",
  params = "",
  poster,
  sizes = "(min-width: 1312px) 1232px, calc(100vw - 32px)",
} = Astro.props;

const query = new URLSearchParams({
  autoplay: "1",
  rel: "0",
  modestbranding: "1",
  playsinline: "1",
});
new URLSearchParams(params).forEach((value, key) => query.set(key, value));

const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?${query}`;
---

<div class="lite-yt" data-lite-yt data-embed={embedUrl} data-title={title}>
  <button class="lite-yt__button" type="button" aria-label={`Reproducir video: ${title}`}>
    <Image
      class="lite-yt__poster"
      src={poster}
      alt=""
      widths={[480, 960, 1280]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
    <span class="lite-yt__scrim" aria-hidden="true"></span>
    <span class="lite-yt__play" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" />
      </svg>
    </span>
  </button>
</div>

<script>
  // Conexión anticipada a YouTube al acercar el puntero o el dedo.
  let warmed = false;
  const warm = () => {
    if (warmed) return;
    warmed = true;
    for (const href of ["https://www.youtube-nocookie.com", "https://www.google.com", "https://i.ytimg.com"]) {
      const link = document.createElement("link");
      link.rel = "preconnect";
      link.href = href;
      document.head.append(link);
    }
  };

  const setup = () => {
    document.querySelectorAll<HTMLElement>("[data-lite-yt]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";
      const button = root.querySelector("button");
      if (!button) return;

      button.addEventListener("pointerenter", warm, { once: true });
      button.addEventListener("touchstart", warm, { once: true, passive: true });
      button.addEventListener("click", () => {
        const iframe = document.createElement("iframe");
        iframe.src = root.dataset.embed ?? "";
        iframe.title = root.dataset.title ?? "Video de YouTube";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        root.classList.add("lite-yt--loaded");
        root.replaceChildren(iframe);
        iframe.focus();
      });
    });
  };

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .lite-yt {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: inherit;
    overflow: hidden;
  }

  .lite-yt__button {
    all: unset;
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .lite-yt__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -4px;
    border-radius: inherit;
  }

  .lite-yt__button :global(.lite-yt__poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.01;
    transition: scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .lite-yt__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 6, 15, 0.3), rgba(5, 6, 15, 0.7));
    transition: opacity 0.4s ease;
  }

  /* Botón de play: 72px (60px en móvil), muy por encima de 44×44 */
  .lite-yt__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    padding-left: 4px;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.92);
    color: #0f172a;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.35);
    transition:
      scale 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.3s ease;
  }

  .lite-yt__button:hover :global(.lite-yt__poster),
  .lite-yt__button:focus-visible :global(.lite-yt__poster) {
    scale: 1.04;
  }

  .lite-yt__button:hover .lite-yt__scrim,
  .lite-yt__button:focus-visible .lite-yt__scrim {
    opacity: 0.75;
  }

  .lite-yt__button:hover .lite-yt__play,
  .lite-yt__button:focus-visible .lite-yt__play {
    scale: 1.06;
    background-color: #fff;
  }

  .lite-yt__button:active .lite-yt__play {
    scale: 0.97;
  }

  .lite-yt--loaded :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 640px) {
    .lite-yt__play {
      width: 60px;
      height: 60px;
      margin: -30px 0 0 -30px;
    }

    .lite-yt__play svg {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lite-yt__button :global(.lite-yt__poster),
    .lite-yt__play {
      transition: background-color 0.3s ease;
    }

    .lite-yt__button:hover :global(.lite-yt__poster),
    .lite-yt__button:focus-visible :global(.lite-yt__poster),
    .lite-yt__button:hover .lite-yt__play,
    .lite-yt__button:focus-visible .lite-yt__play,
    .lite-yt__button:active .lite-yt__play {
      scale: none;
    }
  }
</style>
