---
import { whatsappUrl } from "../../config/site";
---

<section class="tech-section">
    <div class="container tech-section__inner">
        <div class="tech-section__content">
            <div class="tech-section__line" aria-hidden="true"></div>
            <h2 class="tech-section__title">
                ¡Tecnología de Alto Rendimiento Probada en todo el Mundo!
            </h2>
            <p class="tech-section__description">
                Nuestra tecnología ha impulsado negocios desde Ambato Ecuador
                hasta New York Estados Unidos. Optamos por soluciones robustas
                que funcionan sin importar tu ubicación.
            </p>
            <a href={whatsappUrl()} class="tech-section__cta tap">
                ¡Quiero cotizar mi proyecto!
            </a>
        </div>
        <div class="tech-section__image">
            <img
                src="/world.png"
                alt="Mapa mundial conectado representando tecnología global"
                width="450"
                height="450"
            />
        </div>
    </div>
</section>

<style>
    .tech-section {
        position: relative;
        padding: clamp(60px, 12vh, 100px) 0;
        background: #ffffff;
        color: #000;
    }

    .tech-section__inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(40px, 6vw, 80px);
        align-items: center;
    }

    .tech-section__image {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .tech-section__image img {
        width: 100%;
        max-width: 450px;
        height: auto;
        object-fit: contain;
    }

    .tech-section__content {
        display: flex;
        flex-direction: column;
        gap: clamp(12px, 2vh, 20px);
    }

    .tech-section__line {
        width: 60px;
        height: 3px;
        background: var(--color-primary);
        border-radius: 2px;
    }

    .tech-section__title {
        font-size: var(--text-h2);
        font-weight: 700;
        color: #000000;
        margin: 0;
        line-height: var(--leading-heading);
        letter-spacing: var(--tracking-h2);
    }

    .tech-section__description {
        font-size: var(--text-lead);
        line-height: 1.6;
        color: #666666;
        font-weight: 300;
        margin: 0;
    }

    .tech-section__cta {
        background: linear-gradient(90deg, #1b56fd 0%, #133db4 100%);
        color: #fff;
        padding: 10px 28px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 500;
        font-size: var(--text-body);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
    }

    .tech-section__cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(27, 86, 253, 0.4);
    }

    .tech-section__cta:active {
        transform: translateY(0);
    }

    /* Increase padding on desktop */
    @media (min-width: 1024px) {
        .tech-section {
            padding: clamp(140px, 20vh, 220px) 0;
        }
    }

    /* Hide image on all devices smaller than desktop */
    @media (max-width: 1200px) {
        .tech-section__image {
            display: none !important;
            visibility: hidden !important;
        }
    }

    @media (max-width: 1024px) {
        .tech-section__inner {
            display: block !important;
        }

        .tech-section__content {
            text-align: center;
            width: 100%;
            max-width: 100%;
            margin-bottom: clamp(40px, 6vh, 60px);
        }

        .tech-section__line {
            margin: 0 auto clamp(12px, 2vh, 20px);
        }

        .tech-section__title,
        .tech-section__description,
        .tech-section__cta {
            text-align: center;
        }

        .tech-section__cta {
            margin-left: auto;
            margin-right: auto;
        }
    }
</style>
