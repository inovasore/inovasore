---
import { Picture } from "astro:assets";
import { projects } from "../../data/projects";

interface Props {
  /** Grilla decorativa (Grilla02.svg) a los lados. Desactivada en el inicio. */
  showGrid?: boolean;
}

const { showGrid = true } = Astro.props;

// Anchos de las variantes: solo hasta el tamaño real de cada imagen (no se amplía).
const variantWidths = (max: number) =>
  [480, 720, 960, 1280, 1600, 2000, 2880].filter((w) => w < max).concat(max);
---

<section class="projects" id="proyectos" data-projects>
  <div class="projects__halo" aria-hidden="true"></div>
  {
    showGrid && (
      <>
        <img
          src="/Grilla02.svg"
          alt=""
          width="745"
          height="745"
          class="projects__grid-decoration projects__grid-decoration--left"
          aria-hidden="true"
        />
        <img
          src="/Grilla02.svg"
          alt=""
          width="745"
          height="745"
          class="projects__grid-decoration projects__grid-decoration--right"
          aria-hidden="true"
        />
      </>
    )
  }
  <div class="container container--wide projects__inner">
    <span
      class="section-tag projects__tag projects__tag--dark reveal"
      style="--reveal-delay:.06s;--reveal-duration:.45s;--reveal-distance:10px"
    >
      Proyectos
    </span>
    <h2
      class="projects__title reveal"
      style="--reveal-delay:.14s;--reveal-duration:.55s;--reveal-distance:14px"
    >
      Proyectos <span class="highlight text-gradient text-gradient--light">recientes</span>
    </h2>
    <p
      class="projects__subtitle reveal"
      style="--reveal-delay:.22s;--reveal-duration:.45s;--reveal-distance:10px"
    >
      Algunos de los sitios y plataformas que hemos construido para nuestros
      clientes.
    </p>

    <!-- Tarjetas apiladas: cada una queda fija (sticky) y la siguiente sube
         encima; la de abajo se reduce y oscurece (animation-timeline). -->
    <ol class="pstack" role="list" style={`--n:${projects.length}`}>
      {
        projects.map((project, i) => (
          <li class="pstack__item" style={`--i:${i}`}>
            <a
              class="pcard"
              href={project.href}
              aria-label={`Ver proyecto: ${project.title}`}
              data-pcard
            >
              <Picture
                src={project.image}
                alt={project.imageAlt}
                formats={["avif", "webp"]}
                widths={variantWidths(project.image.width)}
                sizes="(min-width: 1568px) 1440px, calc(100vw - 2 * clamp(20px, 5vw, 64px))"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                class="pcard__img"
              />

              <div class="pcard__foot">
              <div class="pcard__bar">
                <div class="pcard__info">
                  <h3 class="pcard__heading">
                    <span class="pcard__title">{project.title}</span>
                    <span class="pcard__category">{project.category}</span>
                  </h3>
                  <p class="pcard__desc">{project.description}</p>
                </div>
                <ul class="pcard__chips" role="list">
                  {project.chips.map((chip) => (
                    <li class="pcard__chip">{chip}</li>
                  ))}
                </ul>
              </div>
              </div>

              <span class="pcard__shade" aria-hidden="true" />

              <span class="pcard__cta" aria-hidden="true" data-pcard-cta>
                Ver proyecto
                <svg viewBox="0 0 20 20" width="16" height="16">
                  <path
                    d="M6 14 14 6M7.5 6H14v6.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <script>
    /*
     * Pastilla "Ver proyecto" que sigue al puntero (skill apple-design):
     * - resorte críticamente amortiguado (sin rebote), solo `translate`;
     * - al entrar arranca en la posición del puntero (sin "vuelo" desde 0,0);
     * - oculta por defecto: se muestra (data-cta-on) solo con el puntero
     *   sobre la imagen, no sobre la barra de información;
     * - al hacer scroll se oculta (la tarjeta se mueve bajo el puntero) y
     *   vuelve con el siguiente movimiento, ya en su posición;
     * - escucha punteros solo mientras la sección está en pantalla;
     * - solo con ratón/trackpad; con movimiento reducido salta sin resorte.
     */
    const section = document.querySelector<HTMLElement>("[data-projects]");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (section && "IntersectionObserver" in window) {
      const cards = [...section.querySelectorAll<HTMLElement>("[data-pcard]")];
      const RESPONSE = 0.09; // s: menor = más rápido en alcanzar el puntero

      let active: HTMLElement | null = null;
      let cta: HTMLElement | null = null;
      let target = { x: 0, y: 0 };
      let current = { x: 0, y: 0 };
      let frame = 0;
      let last = 0;

      const pointToOffset = (card: HTMLElement, e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        const pill = cta?.getBoundingClientRect();
        const maxX = r.width / 2 - (pill ? pill.width / 2 : 0) - 12;
        const anchorY = r.top + r.height * 0.42; // ancla CSS: top 42%
        const maxUp = r.height * 0.42 - (pill ? pill.height / 2 : 0) - 12;
        const maxDown = r.height * 0.58 - (pill ? pill.height / 2 : 0) - 12;
        return {
          x: Math.max(-maxX, Math.min(maxX, e.clientX - (r.left + r.width / 2))),
          y: Math.max(-maxUp, Math.min(maxDown, e.clientY - anchorY)),
        };
      };

      const apply = () => {
        // Incluye el centrado (-50%): la pastilla no usa `transform`
        if (cta) cta.style.translate = `calc(-50% + ${current.x}px) calc(-50% + ${current.y}px)`;
      };

      const step = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        const k = 1 - Math.exp(-dt / RESPONSE);
        current.x += (target.x - current.x) * k;
        current.y += (target.y - current.y) * k;
        apply();
        const settled =
          Math.abs(target.x - current.x) < 0.1 && Math.abs(target.y - current.y) < 0.1;
        frame = settled ? 0 : requestAnimationFrame(step);
      };

      const kick = () => {
        if (frame) return;
        last = performance.now();
        frame = requestAnimationFrame(step);
      };

      const hide = () => {
        active?.removeAttribute("data-cta-on");
        active = null; // el fade lo hace CSS (opacity)
      };

      const onMove = (e: PointerEvent) => {
        if (e.pointerType !== "mouse" && e.pointerType !== "pen") return;
        const card = e.currentTarget as HTMLElement;
        const overBar = !!(e.target as Element).closest?.(".pcard__bar");
        if (overBar) {
          if (active === card) hide();
          return;
        }
        if (active !== card) {
          // Primera aparición: se coloca en el puntero antes de hacerse visible
          hide();
          active = card;
          cta = card.querySelector<HTMLElement>("[data-pcard-cta]");
          target = pointToOffset(card, e);
          current = { ...target };
          apply();
          card.setAttribute("data-cta-on", "");
          return;
        }
        target = pointToOffset(card, e);
        if (reducedMotion.matches) {
          current = { ...target };
          apply();
        } else kick();
      };

      const bind = (on: boolean) => {
        for (const card of cards) {
          const method = on ? "addEventListener" : "removeEventListener";
          card[method]("pointermove", onMove as EventListener);
          card[method]("pointerleave", hide);
        }
        if (on) window.addEventListener("scroll", hide, { passive: true });
        else {
          window.removeEventListener("scroll", hide);
          hide();
        }
        if (!on && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      };

      let bound = false;
      const update = (visible: boolean) => {
        const should = visible && finePointer.matches;
        if (should !== bound) {
          bind(should);
          bound = should;
        }
      };

      let visible = false;
      new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        update(visible);
      }).observe(section);

      finePointer.addEventListener("change", () => update(visible));

      // Al salir de la página o volver con "Atrás" (caché del navegador),
      // al cambiar de pestaña o de ventana, la pastilla queda oculta: solo
      // reaparece con un movimiento real del puntero sobre la imagen.
      const reset = () => hide();
      window.addEventListener("pagehide", reset);
      window.addEventListener("pageshow", reset);
      window.addEventListener("blur", reset);
      document.addEventListener("visibilitychange", reset);
    }
  </script>

  <style>
    .projects {
      position: relative;
      padding: calc(var(--section-padding-y) * 1.5) 0
        calc(var(--section-padding-y) * 1.5);
      background: #ffffff; /* Fondo claro */
      color: #1a1a2e; /* Texto oscuro */
      overflow: visible;
      isolation: isolate;
      margin: 0;
    }

    .projects__halo {
      display: none; /* Ocultar halo en tema claro */
    }

    .projects__grid-decoration {
      position: absolute;
      width: 600px;
      height: auto;
      opacity: 1;
      pointer-events: none;
      z-index: 0;
    }

    .projects__grid-decoration--left {
      left: -50px;
      top: 50%;
      transform: translateY(-50%) scaleX(-1);
    }

    .projects__grid-decoration--right {
      right: -50px;
      top: 50%;
      transform: translateY(-50%);
    }

    .projects__inner {
      position: relative;
      z-index: 1;
      margin-block: 0 clamp(4px, 1.2vh, 10px);
      text-align: center;
    }

    .projects__title {
      font-weight: 600;
      font-size: var(--text-h2);
      margin: clamp(12px, 2.4vh, 18px) auto clamp(10px, 2.4vh, 14px);
      max-width: 28ch;
      color: #1a1a2e;
      line-height: var(--leading-heading);
      letter-spacing: var(--tracking-h2);
    }


    .projects__subtitle {
      color: rgba(30, 30, 60, 0.65);
      max-width: 60ch;
      margin: 0 auto clamp(20px, 6vh, 40px);
      font-size: var(--text-lead);
      font-weight: 400;
    }

    .projects__tag--dark {
      color: #000000;
      opacity: 1;
    }

    /* ================= Tarjetas apiladas ================= */
    /*
     * Todas las tarjetas quedan fijas en el MISMO top y la siguiente cubre
     * por completo a la anterior (misma altura). Altura de la tarjeta:
     * 16:9 del ancho, sin pasar del alto de la pantalla menos márgenes,
     * para que la barra inferior siempre se vea completa.
     * El header no es fijo (se va con el scroll), así que el top es solo
     * un margen.
     */
    .pstack {
      --stack-top: clamp(12px, 2.5vh, 24px);
      --stack-bottom: 16px;
      --stack-gap: clamp(24px, 5vh, 56px);
      --card-ratio: 9 / 16; /* alto / ancho */
      container-type: inline-size; /* 100cqi = ancho de la tarjeta */

      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--stack-gap);
      text-align: left;
      view-timeline: --pstack block;
    }

    .pstack__item {
      position: sticky;
      top: var(--stack-top);
      --card-h: min(
        100cqi * var(--card-ratio),
        100svh - var(--stack-top) - var(--stack-bottom)
      );
    }

    .pcard {
      position: relative;
      display: block;
      width: 100%;
      height: var(--card-h);
      border-radius: clamp(20px, 2.4vw, 32px);
      overflow: hidden;
      isolation: isolate;
      /* Fondo blanco: un fondo oscuro se asomaba por el borde redondeado
         como una línea (borde "pixelado"). */
      background: #fff;
      color: #fff;
      text-decoration: none;
      box-shadow: 0 24px 60px -24px rgb(15 23 42 / 0.45);
      transform-origin: 50% 0;
      container-type: inline-size;
    }

    /* Malla fina de "vidrio cuadriculado" sobre toda la tarjeta (imagen y
       barra). Se integra con los colores de cada imagen (overlay, que se
       nota más en tonos medios: por eso se marca más sobre la barra), no
       recibe el puntero y queda por debajo de la pastilla "Ver proyecto". */
    .pcard::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 3;
      border-radius: inherit;
      background-image:
        /* Líneas con borde suave (se desvanecen en 1px): en pantallas con
           escala no entera (1.25, 1.5, 2.625…) evitan líneas de grosor
           desigual y el efecto moiré. */
        linear-gradient(to right, #fff 0, transparent 1px),
        linear-gradient(to bottom, #fff 0, transparent 1px);
      background-size: var(--mesh, 4px) var(--mesh, 4px);
      opacity: var(--mesh-card, 0.1);
      mix-blend-mode: overlay;
      pointer-events: none;
    }

    .pcard:focus-visible {
      outline: 3px solid var(--color-primary);
      outline-offset: 4px;
    }

    .pcard :global(picture),
    .pcard :global(img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: inherit; /* la imagen se recorta con el mismo radio */
    }

    .pcard :global(img) {
      object-fit: cover;
      object-position: 50% 0; /* capturas de sitios: priorizar la parte superior */
    }

    /* Pie de la tarjeta: contiene la barra de vidrio */
    .pcard__foot {
      --foot-pad: 14px;
      position: absolute;
      inset: auto 0 0;
      z-index: 2;
      padding: 0 var(--foot-pad) var(--foot-pad);
    }

    /* Barra glass (skill apple-design §12): negro al 65 % con blur, sin
       borde, deja ver un poco de la imagen. Sobre una imagen blanca el fondo
       efectivo es ≈ #595959: texto blanco ≥ 4.5:1. */
    .pcard__bar {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 12px 24px;
      padding: 18px 22px;
      border-radius: clamp(14px, 1.6vw, 20px);
      background: rgb(0 0 0 / 0.65);
      box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.35);
      text-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      backdrop-filter: blur(24px) saturate(160%);
    }

    .pcard__heading {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 12px;
    }

    .pcard__title {
      font-size: var(--text-h3);
      font-weight: 600;
      line-height: var(--leading-snug);
      letter-spacing: var(--tracking-h3);
    }

    .pcard__category {
      font-size: var(--text-small);
      letter-spacing: var(--tracking-small);
      color: rgb(255 255 255 / 0.9);
    }

    .pcard__desc {
      margin: 6px 0 0;
      max-width: 62ch;
      font-size: var(--text-body);
      line-height: 1.5;
      color: rgb(255 255 255 / 0.92);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .pcard__chips {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      max-width: 420px;
    }

    /* Chips: vidrio claro sobre la barra (fondo blanco muy transparente,
       borde fino y brillo superior). Sin backdrop-filter propio: dentro de
       la barra solo verían el fondo ya desenfocado de esta, así que no
       cambiaría nada y costaría rendimiento. */
    .pcard__chip {
      padding: 6px 12px;
      border: 1px solid rgb(255 255 255 / 0.26);
      border-radius: 999px;
      background: rgb(255 255 255 / 0.04);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2);
      font-size: var(--text-small);
      line-height: var(--leading-snug);
      color: #fff;
      white-space: nowrap;
    }

    /* Tarjetas angostas (móvil): chips debajo del texto */
    @container (max-width: 720px) {
      .pcard__foot {
        --foot-pad: 10px;
      }

      .pcard__bar {
        grid-template-columns: minmax(0, 1fr);
        padding: 14px 16px;
      }

      .pcard__chips {
        justify-content: flex-start;
        max-width: none;
      }

      .pcard__desc {
        -webkit-line-clamp: 3;
      }
    }

    /* Sombra para la tarjeta que queda debajo (se anima su opacidad) */
    .pcard__shade {
      position: absolute;
      inset: 0;
      z-index: 4;
      background: #000;
      opacity: 0;
      pointer-events: none;
    }

    /* Pastilla "Ver proyecto" (la mueve el script con `translate`) */
    .pcard__cta {
      position: absolute;
      left: 50%;
      top: 42%;
      z-index: 5;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 18px 12px 20px;
      border-radius: 999px;
      background: var(--color-primary);
      color: #fff;
      font-size: var(--text-body);
      font-weight: 600;
      white-space: nowrap;
      box-shadow: 0 10px 30px rgb(27 86 253 / 0.45);
      pointer-events: none;
      /* Solo propiedades individuales (translate/scale), sin `transform`:
         el compilador CSS de Astro 7 fusiona transform + scale en una sola
         matriz y el hover dejaría de cambiar la escala. */
      translate: -50% -50%;
      opacity: 0;
      scale: 0.9;
      transition:
        opacity 0.2s ease-out,
        scale 0.2s ease-out;
    }

    .pcard[data-cta-on] .pcard__cta,
    .pcard:focus-visible .pcard__cta {
      opacity: 1;
      scale: 1;
    }

    /* Pantallas táctiles: sin cursor, la pastilla queda fija, opaca y visible */
    @media (hover: none), (pointer: coarse) {
      .pcard__cta {
        left: auto;
        right: 14px;
        top: 14px;
        translate: none;
        opacity: 1;
        scale: 1;
        padding: 10px 14px 10px 16px;
        font-size: var(--text-small);
      }
    }

    /* Profundidad: la tarjeta que queda debajo se reduce y oscurece mientras
       la siguiente sube. El rango va de cuando la tarjeta i se fija hasta
       cuando se fija la i+1 (recorrido = alto de tarjeta + separación),
       medido sobre el recorrido de la lista. Con transform-origin arriba,
       al reducirse queda dentro de la que la cubre: no asoma ningún borde.
       Sin soporte: el apilado sticky funciona igual. */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .pstack__item:not(:last-child) .pcard,
        .pstack__item:not(:last-child) .pcard__shade {
          animation-timeline: --pstack;
          animation-fill-mode: both;
          animation-timing-function: linear;
          animation-range:
            exit-crossing
              calc(var(--i) * (var(--card-h) + var(--stack-gap)) - var(--stack-top))
            exit-crossing
              calc(
                (var(--i) + 1) * (var(--card-h) + var(--stack-gap)) -
                  var(--stack-top)
              );
        }

        .pstack__item:not(:last-child) .pcard {
          animation-name: pstack-recede;
        }

        .pstack__item:not(:last-child) .pcard__shade {
          animation-name: pstack-dim;
        }
      }
    }

    @keyframes pstack-recede {
      to {
        scale: 0.93;
      }
    }

    @keyframes pstack-dim {
      to {
        opacity: 0.4;
      }
    }

    /* Móvil vertical: tarjeta más alta para la barra con chips debajo */
    @media (max-width: 640px) {
      .pstack {
        --card-ratio: 5 / 4;
      }
    }

    /* Pantalla muy baja (p. ej. celular horizontal): sin sticky, tarjetas
       una debajo de otra y cada una cabe en la pantalla */
    @media (max-height: 500px) {
      .pstack__item {
        position: static;
      }
      .pstack {
        --stack-top: 0px;
        --stack-bottom: 24px;
      }
      .pstack__item:not(:last-child) .pcard,
      .pstack__item:not(:last-child) .pcard__shade {
        animation: none;
      }
    }

    /* Transparencia reducida: el mismo negro al 65 % pero sin blur. Sobre
       una imagen blanca el fondo sigue siendo ≈ #595959 (texto ≥ 4.5:1). */
    @media (prefers-reduced-transparency: reduce) {
      .pcard__bar {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }

    /* Más contraste: barra oscura sólida, sin blur */
    @media (prefers-contrast: more) {
      .pcard__bar {
        background: rgb(14 14 18 / 0.96);
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }

      .pcard__chip {
        background: rgb(255 255 255 / 0.03);
      }
    }

    /* Movimiento reducido: sin apilado ni pastilla que sigue al cursor */
    @media (prefers-reduced-motion: reduce) {
      .pstack__item {
        position: static;
      }

      .pcard__cta {
        transition: none;
      }
    }

    @media (max-width: 720px) {
      .projects {
        padding: var(--section-padding-y-tight) 0;
      }

      .projects__inner {
        text-align: center;
      }
    }

    @media (max-width: 640px) {
      .projects {
        padding-top: calc(var(--section-padding-y) * 2.5);
      }

      .projects__grid-decoration {
        display: none;
      }
    }

    @media (max-width: 520px) {
      .projects__subtitle {
        margin-bottom: clamp(20px, 6vh, 32px);
      }
    }
  </style>
</section>
