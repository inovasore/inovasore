---
import { Picture } from "astro:assets";
import { projects } from "../../data/projects";

// Anchos de las variantes: solo hasta el tamaño real de cada imagen (no se amplía).
const variantWidths = (max: number) =>
  [480, 720, 960, 1280, 1600, 2000, 2880].filter((w) => w < max).concat(max);
---

<section class="projects" id="proyectos" data-projects>
  <div class="projects__halo" aria-hidden="true"></div>
  <img
    src="/Grilla02.svg"
    alt=""
    width="745"
    height="745"
    class="projects__grid-decoration projects__grid-decoration--left"
    aria-hidden="true"
  />
  <img
    src="/Grilla02.svg"
    alt=""
    width="745"
    height="745"
    class="projects__grid-decoration projects__grid-decoration--right"
    aria-hidden="true"
  />
  <div class="container container--wide projects__inner">
    <span
      class="section-tag projects__tag projects__tag--dark reveal"
      style="--reveal-delay:.06s;--reveal-duration:.45s;--reveal-distance:10px"
    >
      Proyectos
    </span>
    <h2
      class="projects__title reveal"
      style="--reveal-delay:.14s;--reveal-duration:.55s;--reveal-distance:14px"
    >
      ¡Proyectos <span class="highlight">que dan resultados!</span>
    </h2>
    <p
      class="projects__subtitle reveal"
      style="--reveal-delay:.22s;--reveal-duration:.45s;--reveal-distance:10px"
    >
      Diseñamos experiencias digitales para marcas que confían en nuestra
      capacidad para crear estrategias y visuales impactantes.
    </p>

    <!-- Tarjetas apiladas: cada una queda fija (sticky) y la siguiente sube
         encima; la de abajo se reduce y oscurece (animation-timeline). -->
    <ol class="pstack" role="list" style={`--n:${projects.length}`}>
      {
        projects.map((project, i) => (
          <li class="pstack__item" style={`--i:${i}`}>
            <a
              class="pcard"
              href={project.href}
              aria-label={`Ver proyecto: ${project.title}`}
              data-pcard
            >
              <Picture
                src={project.image}
                alt={project.imageAlt}
                formats={["avif", "webp"]}
                widths={variantWidths(project.image.width)}
                sizes="(min-width: 1568px) 1440px, calc(100vw - 2 * clamp(20px, 5vw, 64px))"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                class="pcard__img"
              />

              <div class="pcard__bar">
                <div class="pcard__info">
                  <h3 class="pcard__heading">
                    <span class="pcard__title">{project.title}</span>
                    <span class="pcard__category">{project.category}</span>
                  </h3>
                  <p class="pcard__desc">{project.description}</p>
                </div>
                <ul class="pcard__chips" role="list">
                  {project.chips.map((chip) => (
                    <li class="pcard__chip">{chip}</li>
                  ))}
                </ul>
              </div>

              <span class="pcard__shade" aria-hidden="true" />

              <span class="pcard__cta" aria-hidden="true" data-pcard-cta>
                Ver proyecto
                <svg viewBox="0 0 20 20" width="16" height="16">
                  <path
                    d="M6 14 14 6M7.5 6H14v6.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <script>
    /*
     * Pastilla "Ver proyecto" que sigue al puntero (skill apple-design):
     * - resorte críticamente amortiguado (sin rebote), solo `translate`;
     * - al entrar arranca en la posición del puntero (sin "vuelo" desde 0,0);
     * - escucha punteros solo mientras la sección está en pantalla;
     * - solo con ratón/trackpad y sin prefers-reduced-motion.
     */
    const section = document.querySelector<HTMLElement>("[data-projects]");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (section && "IntersectionObserver" in window) {
      const cards = [...section.querySelectorAll<HTMLElement>("[data-pcard]")];
      const RESPONSE = 0.09; // s: menor = más rápido en alcanzar el puntero

      let active: HTMLElement | null = null;
      let cta: HTMLElement | null = null;
      let target = { x: 0, y: 0 };
      let current = { x: 0, y: 0 };
      let frame = 0;
      let last = 0;

      const pointToOffset = (card: HTMLElement, e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        const pill = cta?.getBoundingClientRect();
        const maxX = r.width / 2 - (pill ? pill.width / 2 : 0) - 12;
        const anchorY = r.top + r.height * 0.42; // ancla CSS: top 42%
        const maxUp = r.height * 0.42 - (pill ? pill.height / 2 : 0) - 12;
        const maxDown = r.height * 0.58 - (pill ? pill.height / 2 : 0) - 12;
        return {
          x: Math.max(-maxX, Math.min(maxX, e.clientX - (r.left + r.width / 2))),
          y: Math.max(-maxUp, Math.min(maxDown, e.clientY - anchorY)),
        };
      };

      const apply = () => {
        // Incluye el centrado (-50%): la pastilla no usa `transform`
        if (cta) cta.style.translate = `calc(-50% + ${current.x}px) calc(-50% + ${current.y}px)`;
      };

      const step = (now: number) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        const k = 1 - Math.exp(-dt / RESPONSE);
        current.x += (target.x - current.x) * k;
        current.y += (target.y - current.y) * k;
        apply();
        const settled =
          Math.abs(target.x - current.x) < 0.1 && Math.abs(target.y - current.y) < 0.1;
        frame = settled ? 0 : requestAnimationFrame(step);
      };

      const kick = () => {
        if (frame) return;
        last = performance.now();
        frame = requestAnimationFrame(step);
      };

      const onEnter = (e: PointerEvent) => {
        if (e.pointerType !== "mouse" && e.pointerType !== "pen") return;
        active = e.currentTarget as HTMLElement;
        cta = active.querySelector<HTMLElement>("[data-pcard-cta]");
        target = pointToOffset(active, e);
        current = { ...target }; // aparece donde está el puntero
        apply();
      };

      const onMove = (e: PointerEvent) => {
        if (!active || e.currentTarget !== active) return;
        target = pointToOffset(active, e);
        kick();
      };

      const onLeave = () => {
        active = null; // el fade lo hace CSS (opacity)
      };

      const bind = (on: boolean) => {
        for (const card of cards) {
          const method = on ? "addEventListener" : "removeEventListener";
          card[method]("pointerenter", onEnter as EventListener);
          card[method]("pointermove", onMove as EventListener);
          card[method]("pointerleave", onLeave);
        }
        if (!on && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      };

      let bound = false;
      const update = (visible: boolean) => {
        const should = visible && finePointer.matches && !reducedMotion.matches;
        if (should !== bound) {
          bind(should);
          bound = should;
        }
      };

      let visible = false;
      new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        update(visible);
      }).observe(section);

      finePointer.addEventListener("change", () => update(visible));
      reducedMotion.addEventListener("change", () => update(visible));
    }
  </script>

  <style>
    .projects {
      position: relative;
      padding: calc(var(--section-padding-y) * 1.5) 0
        calc(var(--section-padding-y) * 1.5);
      background: #ffffff; /* Fondo claro */
      color: #1a1a2e; /* Texto oscuro */
      overflow: visible;
      isolation: isolate;
      margin: 0;
    }

    .projects__halo {
      display: none; /* Ocultar halo en tema claro */
    }

    .projects__grid-decoration {
      position: absolute;
      width: 600px;
      height: auto;
      opacity: 1;
      pointer-events: none;
      z-index: 0;
    }

    .projects__grid-decoration--left {
      left: -50px;
      top: 50%;
      transform: translateY(-50%) scaleX(-1);
    }

    .projects__grid-decoration--right {
      right: -50px;
      top: 50%;
      transform: translateY(-50%);
    }

    .projects__inner {
      position: relative;
      z-index: 1;
      margin-block: 0 clamp(4px, 1.2vh, 10px);
      text-align: center;
    }

    .projects__title {
      font-weight: 600;
      font-size: var(--text-h2);
      margin: clamp(12px, 2.4vh, 18px) auto clamp(10px, 2.4vh, 14px);
      max-width: 28ch;
      color: #1a1a2e;
      line-height: var(--leading-heading);
      letter-spacing: var(--tracking-h2);
    }

    .projects__title .highlight {
      background-image: linear-gradient(
        90deg,
        #26d2f8,
        #23b2ff,
        #0973e1 70%,
        #3b5bff
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .projects__subtitle {
      color: rgba(30, 30, 60, 0.65);
      max-width: 60ch;
      margin: 0 auto clamp(20px, 6vh, 40px);
      font-size: var(--text-lead);
      font-weight: 400;
    }

    .projects__tag--dark {
      color: #000000;
      opacity: 1;
    }

    /* ================= Tarjetas apiladas ================= */
    .pstack {
      --stack-top: clamp(16px, 4vh, 40px);
      --stack-step: 14px; /* cada tarjeta queda un poco más abajo: se ve el borde de la anterior */
      --stack-gap: clamp(24px, 5vh, 56px);

      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--stack-gap);
      text-align: left;
      view-timeline: --pstack block;
    }

    .pstack__item {
      position: sticky;
      top: calc(var(--stack-top) + var(--i) * var(--stack-step));
    }

    .pcard {
      --card-top: calc(var(--stack-top) + var(--i) * var(--stack-step));

      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      /* Nunca más alta que la pantalla: la barra inferior no se corta */
      max-height: calc(100vh - var(--card-top) - 24px);
      max-height: calc(100svh - var(--card-top) - 24px);
      border-radius: clamp(20px, 2.4vw, 32px);
      overflow: hidden;
      isolation: isolate;
      background: #0b1020;
      color: #fff;
      text-decoration: none;
      box-shadow: 0 24px 60px -24px rgb(15 23 42 / 0.45);
      transform-origin: 50% 0;
      container-type: inline-size;
    }

    .pcard:focus-visible {
      outline: 3px solid var(--color-primary);
      outline-offset: 4px;
    }

    .pcard :global(picture),
    .pcard :global(img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .pcard :global(img) {
      object-fit: cover;
      object-position: 50% 0; /* capturas de sitios: priorizar la parte superior */
    }

    /* Barra glass inferior (skill apple-design §12) */
    .pcard__bar {
      position: absolute;
      inset: auto 14px 14px;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 12px 24px;
      padding: 18px 22px;
      border-radius: clamp(14px, 1.6vw, 20px);
      border: 1px solid rgb(255 255 255 / 0.14);
      /* 0.7 de opacidad: ≥ 4.5:1 de contraste incluso sobre una imagen blanca */
      background: rgb(10 14 28 / 0.7);
      -webkit-backdrop-filter: blur(18px) saturate(160%);
      backdrop-filter: blur(18px) saturate(160%);
    }

    .pcard__heading {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 12px;
    }

    .pcard__title {
      font-size: var(--text-h3);
      font-weight: 600;
      line-height: var(--leading-snug);
      letter-spacing: var(--tracking-h3);
    }

    .pcard__category {
      font-size: var(--text-small);
      letter-spacing: var(--tracking-small);
      color: #d7deea;
    }

    .pcard__desc {
      margin: 6px 0 0;
      max-width: 62ch;
      font-size: var(--text-body);
      line-height: 1.5;
      color: #e2e8f0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .pcard__chips {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      max-width: 420px;
    }

    .pcard__chip {
      padding: 6px 12px;
      border: 1px solid rgb(255 255 255 / 0.32);
      border-radius: 999px;
      font-size: var(--text-small);
      line-height: var(--leading-snug);
      color: #fff;
      white-space: nowrap;
    }

    /* Tarjetas angostas (móvil): chips debajo del texto */
    @container (max-width: 720px) {
      .pcard__bar {
        grid-template-columns: minmax(0, 1fr);
        inset: auto 10px 10px;
        padding: 14px 16px;
      }

      .pcard__chips {
        justify-content: flex-start;
        max-width: none;
      }

      .pcard__desc {
        -webkit-line-clamp: 3;
      }
    }

    /* Sombra para la tarjeta que queda debajo (se anima su opacidad) */
    .pcard__shade {
      position: absolute;
      inset: 0;
      z-index: 3;
      background: #000;
      opacity: 0;
      pointer-events: none;
    }

    /* Pastilla "Ver proyecto" (la mueve el script con `translate`) */
    .pcard__cta {
      position: absolute;
      left: 50%;
      top: 42%;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 18px 12px 20px;
      border-radius: 999px;
      background: var(--color-primary);
      color: #fff;
      font-size: var(--text-body);
      font-weight: 600;
      white-space: nowrap;
      box-shadow: 0 10px 30px rgb(27 86 253 / 0.45);
      pointer-events: none;
      /* Solo propiedades individuales (translate/scale), sin `transform`:
         el compilador CSS de Astro 7 fusiona transform + scale en una sola
         matriz y el hover dejaría de cambiar la escala. */
      translate: -50% -50%;
      opacity: 0;
      scale: 0.9;
      transition:
        opacity 0.2s ease-out,
        scale 0.2s ease-out;
    }

    .pcard:hover .pcard__cta,
    .pcard:focus-visible .pcard__cta {
      opacity: 1;
      scale: 1;
    }

    /* Pantallas táctiles: sin cursor, la pastilla queda fija y visible */
    @media (pointer: coarse) {
      .pcard__cta {
        left: auto;
        right: 14px;
        top: 14px;
        translate: none;
        opacity: 1;
        scale: 1;
        padding: 10px 14px 10px 16px;
        font-size: var(--text-small);
      }
    }

    /* Profundidad: la tarjeta que queda debajo se reduce y oscurece mientras
       la siguiente sube. Rango calculado por posición (--i de --n) sobre el
       recorrido de la lista. Sin soporte: el apilado sticky funciona igual. */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .pstack__item:not(:last-child) .pcard,
        .pstack__item:not(:last-child) .pcard__shade {
          animation-timeline: --pstack;
          animation-fill-mode: both;
          animation-timing-function: linear;
          animation-range:
            exit-crossing calc(var(--i) / var(--n) * 100%)
            exit-crossing calc((var(--i) + 1) / var(--n) * 100%);
        }

        .pstack__item:not(:last-child) .pcard {
          animation-name: pstack-recede;
        }

        .pstack__item:not(:last-child) .pcard__shade {
          animation-name: pstack-dim;
        }
      }
    }

    @keyframes pstack-recede {
      to {
        scale: 0.93;
      }
    }

    @keyframes pstack-dim {
      to {
        opacity: 0.4;
      }
    }

    /* Móvil vertical: tarjeta más alta para la barra con chips debajo */
    @media (max-width: 640px) {
      .pcard {
        aspect-ratio: 4 / 5;
      }
    }

    /* Pantalla muy baja: sin sticky (tarjetas una debajo de otra) */
    @media (max-height: 340px) {
      .pstack__item {
        position: static;
      }
    }

    /* Transparencia reducida: barra sólida */
    @media (prefers-reduced-transparency: reduce) {
      .pcard__bar {
        background: rgb(10 14 28 / 0.94);
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }

    /* Movimiento reducido: sin apilado ni pastilla que sigue al cursor */
    @media (prefers-reduced-motion: reduce) {
      .pstack__item {
        position: static;
      }

      .pcard__cta {
        transition: none;
      }
    }

    @media (max-width: 720px) {
      .projects {
        padding: var(--section-padding-y-tight) 0;
      }

      .projects__inner {
        text-align: center;
      }
    }

    @media (max-width: 640px) {
      .projects {
        padding-top: calc(var(--section-padding-y) * 2.5);
      }

      .projects__grid-decoration {
        display: none;
      }
    }

    @media (max-width: 520px) {
      .projects__subtitle {
        margin-bottom: clamp(20px, 6vh, 32px);
      }
    }
  </style>
</section>
