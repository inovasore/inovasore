---
import Icon from "../ui/Icon.astro";
import { faqs } from "../../data/faqs";
---

<section class="faq" id="faq">
  <div class="container container--center faq__inner">
    <span
      class="section-tag faq__tag reveal"
      style="--reveal-delay:.04s;--reveal-duration:.45s;--reveal-distance:10px;border:1px solid #1B56FD !important"
    >
      Preguntas frecuentes
    </span>

    <h2
      class="faq__title reveal"
      style="--reveal-delay:.12s;--reveal-duration:.55s;--reveal-distance:12px"
    >
      Resolvemos tus <span class="highlight text-gradient">dudas antes de empezar</span>
    </h2>

    <p
      class="faq__subtitle reveal"
      style="--reveal-delay:.2s;--reveal-duration:.45s;--reveal-distance:10px"
    >
      Respuestas claras sobre nuestros servicios, procesos y soporte para que
      tomes decisiones con confianza.
    </p>

    <div class="faq__grid">
      {
        faqs.map((item, index) => (
          <details
            class="faq__item reveal"
            name="faq"
            style={`--reveal-delay:${(0.16 + index * 0.06).toFixed(2)}s;--reveal-duration:.45s;--reveal-distance:12px`}
          >
            <summary class="faq__question">
              <span>{item.question}</span>
              <span class="faq__icon" aria-hidden="true">
                <Icon name="add" class="faq__icon-closed" />
                <Icon name="remove" class="faq__icon-open" />
              </span>
            </summary>
            <div class="faq__answer">
              {item.link ? (
                <p>
                  {item.answer.split(item.link.text)[0]}
                  <a class="faq__link" href={item.link.href}>{item.link.text}</a>
                  {item.answer.split(item.link.text).slice(1).join(item.link.text)}
                </p>
              ) : (
                <p>{item.answer}</p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>

  <style>
    .faq {
      position: relative;
      /* clip (no hidden): no crea un contenedor de scroll, así funciona
         animation-timeline: view(). flow-root conserva el BFC de hidden. */
      overflow: clip;
      display: flow-root;
      isolation: isolate;
      padding: var(--section-padding-y) 0;
      background: var(--color-bg);
      color: var(--color-text);
    }

    .faq__title {
      font-size: var(--text-h2);
      font-weight: 600;
      margin: clamp(4px, 1.8vh, 8px) auto clamp(4px, 1.8vh, 8px);
      max-width: 28ch;
      line-height: var(--leading-heading);
      letter-spacing: var(--tracking-h2);
    }


    .faq__subtitle {
      color: color-mix(in oklab, var(--color-text) 62%, transparent);
      font-size: var(--text-lead);
      max-width: 60ch;
      margin: 0 auto clamp(26px, 6vh, 40px);
      font-weight: 300;
    }

    .faq__grid {
      display: grid;
      gap: clamp(8px, 1.6vh, 12px);
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      grid-auto-rows: minmax(0, auto);
    }

    @media (min-width: 900px) {
      .faq__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(10px, 2vw, 16px);
      }
    }

    .faq__item {
      position: relative;
      align-self: start;
      height: auto;
      padding: 0.25rem;
      border-radius: clamp(16px, 1.4vw, 20px);
      border-color: rgba(255, 255, 255, 0.08);
      background: linear-gradient(
        180deg,
        rgba(12, 14, 22, 0.92),
        rgba(12, 14, 22, 0.86)
      );
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
      transition:
        transform 0.25s ease,
        box-shadow 0.28s ease,
        border-color 0.28s ease,
        background 0.28s ease;
      backdrop-filter: blur(12px);
    }

    @supports not ((backdrop-filter: blur(1px))) {
      .faq__item {
        backdrop-filter: none;
      }
    }

    .faq__item::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background:
        radial-gradient(
          380px 240px at 85% 18%,
          color-mix(in oklab, var(--color-primary) 20%, transparent),
          transparent 72%
        ),
        radial-gradient(
          320px 220px at 15% 88%,
          color-mix(in oklab, var(--color-primary-dark) 14%, transparent),
          transparent 78%
        );
      opacity: 0.12;
      transition: opacity 0.28s ease;
      mix-blend-mode: screen;
    }

    .faq__item:hover,
    .faq__item[open] {
      transform: translateY(-2px);
      border-color: rgba(59, 130, 246, 0.35);
      box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .faq__item:hover::after,
    .faq__item[open]::after {
      opacity: 0.24;
    }

    .faq__question {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.85rem;
      padding: 0.9rem 1.15rem;
      border-radius: calc(clamp(12px, 1.4vw, 16px) - 0.25rem);
      color: color-mix(in oklab, var(--color-text) 88%, transparent);
      font-size: var(--text-h3);
      font-weight: 400;
      cursor: pointer;
      background: transparent;
      border: none;
      text-align: left;
      font-family: inherit;
      transition: color 0.22s ease;
      line-height: var(--leading-snug);
      letter-spacing: var(--tracking-h3);
    }

    .faq__question > span:first-child {
      flex: 1;
    }

    .faq__item:hover .faq__question,
    .faq__item[open] .faq__question {
      color: color-mix(in oklab, var(--color-primary) 60%, var(--color-text));
    }

    .faq__question:focus-visible {
      outline: 2px solid
        color-mix(in oklab, var(--color-primary) 60%, transparent);
      outline-offset: 6px;
      border-radius: inherit;
    }

    .faq__icon {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 999px;
      background: var(--color-primary);
      color: #fff;
      border: none;
      box-shadow: none;
      font-size: 1.25rem;
      transition:
        transform 0.28s ease,
        background 0.28s ease,
        border-color 0.28s ease,
        color 0.28s ease;
    }

    .faq__item:hover .faq__icon,
    .faq__item[open] .faq__icon {
      background: color-mix(in oklab, var(--color-primary) 22%, transparent);
      border-color: color-mix(in oklab, var(--color-primary) 48%, transparent);
      color: #f8fafc;
    }

    .faq__answer {
      margin: 0;
      padding: 0 1.2rem 1.05rem;
      color: color-mix(in oklab, var(--color-text) 70%, transparent);
      font-size: var(--text-body);
      line-height: 1.65;
      position: relative;
      text-align: left;
    }

    .faq__answer::before {
      content: "";
      display: block;
      height: 1px;
      margin: 0 0 1rem;
      background: color-mix(in oklab, var(--color-text) 16%, transparent);
      opacity: 0.5;
      transition:
        background 0.28s ease,
        opacity 0.28s ease;
    }

    .faq__item[open] .faq__answer::before {
      background: color-mix(in oklab, var(--color-primary) 40%, transparent);
      opacity: 0.85;
    }

    .faq__answer > p {
      margin: 0;
    }

    .faq__link {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* summary (del details) sin el marcador nativo del navegador */
    .faq__question {
      list-style: none;
    }

    .faq__question::-webkit-details-marker {
      display: none;
    }

    .faq__icon-open,
    .faq__item[open] .faq__icon-closed {
      display: none;
    }

    .faq__item[open] .faq__icon-open {
      display: inline;
    }

    /* Estas reglas quedaron sin su @media (max-width: 720px) en una versión
       anterior y hoy aplican en todas las pantallas; se conservan así para
       no cambiar el diseño actual. */
    .faq__question {
      padding: 0.75rem 1rem;
      gap: 0.7rem;
    }

    .faq__answer {
      padding: 0 1rem 0.9rem;
    }
  </style>
</section>
