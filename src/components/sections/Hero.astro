---
import { heroContent } from "../../data/hero";
import { Image } from "astro:assets";

const { title, tagline, subtitle, works } = heroContent;
const [primaryWork, ...secondaryWorks] = works;
---

<section class="hero">
  <div class="container hero__inner">
    <div
      class="pill enter"
      style="--enter-delay:.08s;--enter-duration:.48s;--enter-distance:10px;--pill-weight:400"
    >
      <span class="pill__text">{tagline}</span>
      <a class="pill__cta tap" href="/contacto" aria-label="Ir a contacto">
        <img src="/Bar01.svg" alt="" width="28" height="28" />
      </a>
    </div>

    <!-- Es el elemento LCP: entra con animación CSS (sin esperar a JS) -->
    <h1
      class="hero__title enter"
      style="--enter-delay:.16s;--enter-duration:.55s;--enter-distance:14px"
    >
      {title}
    </h1>

    <p
      class="hero__subtitle enter"
      style="--enter-delay:.26s;--enter-duration:.45s;--enter-distance:10px"
    >
      {subtitle}
    </p>

    <div class="hero__actions">
      <a
        class="btn-hero-primary enter"
        href="/contacto"
        style="--enter-delay:.34s;--enter-duration:.45s;--enter-distance:10px"
      >
        <span class="btn-icon-circle">
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M7.5 5L12.5 10L7.5 15"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        Iniciar Proyecto
      </a>
    </div>
  </div>
  <div class="carousel carousel--auto" data-speed="35">
    <div class="carousel__track" tabindex="-1">
      <figure class="carousel__item">
        <Image
          src={primaryWork}
          alt="Proyecto destacado 1"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width={440}
          height={275}
        />
      </figure>
      {
        secondaryWorks.map((src, i) => (
          <figure class="carousel__item">
            <Image
              src={src}
              alt={`Proyecto ${i + 2}`}
              loading="lazy"
              decoding="async"
              width={440}
              height={275}
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const setupAutoCarousels = () => {
    // Mobile check removed to allow animation on all devices

    if (
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return;
    }

    const cleanups: (() => void)[] = [];

    document
      .querySelectorAll(".carousel.carousel--auto")
      .forEach((carousel) => {
        const track = carousel.querySelector(".carousel__track") as HTMLElement;
        if (!track || track.dataset.running === "true") return;
        track.dataset.running = "true";

        const originals = Array.from(track.children) as HTMLElement[];

        // Calculate dimensions once to avoid reflow in loop
        let gap = parseFloat(getComputedStyle(track).gap || "0") || 0;
        let itemWidths = originals.map(
          (node) => node.getBoundingClientRect().width + gap,
        );

        const ensureCoverage = () => {
          gap = parseFloat(getComputedStyle(track).gap || "0") || 0;
          const required = carousel.clientWidth * 2;
          let total = 0;

          // Re-calculate current total width
          const currentChildren = Array.from(track.children) as HTMLElement[];
          currentChildren.forEach((child) => {
            total += child.getBoundingClientRect().width + gap;
          });

          // Only clone if needed
          let guard = 0;
          while (total < required && guard++ < 12) {
            originals.forEach((node) => {
              const clone = node.cloneNode(true) as HTMLElement;
              track.appendChild(clone);
              // Optimistically add width to total to avoid reading DOM again immediately
              total += node.getBoundingClientRect().width + gap;
            });
          }
        };

        // Initial coverage check
        ensureCoverage();

        // Debounced resize handler
        let resizeTimeout: ReturnType<typeof setTimeout>;
        const resizeHandler = () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
            ensureCoverage();
          }, 100);
        };
        window.addEventListener("resize", resizeHandler, { passive: true });

        // Ensure images are loaded before final measurement
        track.querySelectorAll("img").forEach((img) => {
          if (img.complete) return;
          img.addEventListener("load", () => ensureCoverage(), { once: true });
        });

        let inView = true;
        let observer: IntersectionObserver;

        const speed = Number((carousel as HTMLElement).dataset.speed || 28);
        let offset = 0;
        let last = 0;
        let frameId = 0;

        const shouldRun = () => !document.hidden && inView;

        const stop = () => {
          if (frameId) {
            cancelAnimationFrame(frameId);
            frameId = 0;
          }
          last = 0;
        };

        const step = (now: number) => {
          if (!shouldRun()) {
            stop();
            return;
          }

          if (!last) {
            last = now;
          }

          const delta = (now - last) / 1000;
          last = now;

          offset -= speed * delta;

          // For left-to-right scrolling visually, we decrement offset (move left)
          // and move first element to end when it goes off screen
          let first = track.firstElementChild as HTMLElement;
          if (first) {
            if (Math.abs(offset) > 200) {
              const width = first.getBoundingClientRect().width + gap;
              if (Math.abs(offset) >= width) {
                track.appendChild(first);
                offset += width;
              }
            }
          }

          track.style.transform = `translate3d(${offset}px,0,0)`;
          frameId = requestAnimationFrame(step);
        };

        const start = () => {
          if (frameId || !shouldRun()) return;
          last = performance.now();
          frameId = requestAnimationFrame(step);
        };

        const updateRunner = () => {
          if (shouldRun()) {
            start();
          } else {
            stop();
          }
        };

        const visibilityHandler = () => updateRunner();
        document.addEventListener("visibilitychange", visibilityHandler);

        if ("IntersectionObserver" in window) {
          observer = new IntersectionObserver(
            (entries) => {
              const visible = entries.some((entry) => entry.isIntersecting);
              if (visible !== inView) {
                inView = visible;
                updateRunner();
              }
            },
            { threshold: 0.01 },
          );
          observer.observe(carousel);
        }

        updateRunner();

        const cleanup = () => {
          stop();
          window.removeEventListener("resize", resizeHandler);
          document.removeEventListener("visibilitychange", visibilityHandler);
          observer?.disconnect();
          delete track.dataset.running;
          track.style.transform = `translate3d(${-offset}px,0,0)`;
        };

        cleanups.push(cleanup);
      });

    if (cleanups.length) {
      const runCleanups = () => {
        cleanups.splice(0).forEach((fn) => {
          try {
            fn();
          } catch (_) {}
        });
      };
      document.addEventListener("astro:before-swap", runCleanups, {
        once: true,
      });
      window.addEventListener("beforeunload", runCleanups, { once: true });
    }
  };

  const scheduleCarousels = () => {
    const start = () => setupAutoCarousels();
    if ("requestIdleCallback" in window) {
      requestIdleCallback(start, { timeout: 1200 });
    } else {
      setTimeout(start, 180);
    }
  };

  if (document.readyState === "complete") {
    scheduleCarousels();
  } else {
    window.addEventListener("load", scheduleCarousels, { once: true });
  }

  document.addEventListener("astro:page-load", scheduleCarousels);
</script>

<style>
  :root {
    --nav-h: 72px;
  }

  .hero {
    z-index: 0;
  }

  .hero {
    position: relative;
    padding: calc(var(--nav-h, 72px) + 120px) 0 var(--section-padding-y);
    min-height: 86vh;
    min-height: 86svh;
    background: var(--color-bg);
    color: var(--color-text);
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      url("/Vectorbg.svg") center center / cover,
      url("/bg-hero.svg") no-repeat center top / 1600px auto;
    opacity: 0.95;
    pointer-events: none;
    z-index: -1;
    will-change: opacity;
  }

  .hero__inner {
    text-align: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--surface, #f3f4f6) 60%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-text);
    margin-bottom: 20px;
  }
  .pill__text {
    font-weight: var(--pill-weight, 400);
    font-size: var(--text-hero-body);
    letter-spacing: var(--tracking-body);
  }
  .pill__cta {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 400;
    line-height: 1;
  }

  .hero__title {
    font-weight: 600;
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    margin: 0.35rem auto 0;
    /* Líneas parejas: 2 en escritorio/tablet/horizontal, 4 en móvil vertical */
    max-width: 28ch;
    text-wrap: balance;
  }


  .hero__subtitle {
    /* #cbd5e1: contraste ≥ 4.5:1 sobre el fondo y la cuadrícula del hero */
    color: #cbd5e1;
    font-size: var(--text-hero-lead);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
    margin: clamp(16px, 2.6vh, 28px) auto 28px;
    max-width: 52ch;
    text-wrap: balance;
    font-weight: 400;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: clamp(45px, 8vh, 75px);
  }

  .btn-hero-primary {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 12px 22px 12px 16px !important;
    border-radius: 999px !important;
    background: linear-gradient(90deg, #1b56fd 0%, #133db4 100%) !important;
    color: #fff !important;
    text-decoration: none !important;
    font-weight: 500 !important;
    font-size: var(--text-hero-body) !important;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease !important;
    box-shadow: 0 4px 12px rgba(27, 86, 253, 0.3) !important;
    border: none !important;
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 20px rgba(27, 86, 253, 0.4) !important;
    background: linear-gradient(90deg, #1b56fd 0%, #133db4 100%) !important;
  }

  .btn-hero-primary:active {
    transform: translateY(0) !important;
  }

  .btn-icon-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .btn-icon-circle svg {
    transition: transform 0.2s ease;
  }

  .btn-hero-primary:hover .btn-icon-circle {
    background: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 768px) {
    .pill {
      gap: 0.5rem;
      padding: 6px 6px 6px 16px;
      margin-bottom: 12px;
      width: fit-content;
      max-width: 100%;
    }

    .pill__text {
      font-size: var(--text-small);
      letter-spacing: var(--tracking-small);
      line-height: var(--leading-snug);
      text-align: left;
    }

    .pill__cta {
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      font-size: 1rem;
    }

    .hero__actions {
      flex-direction: column;
      gap: 0.55rem;
      align-items: center;
      margin-inline: auto;
    }

  }

  .carousel {
    position: relative;
    width: 100vw;
    max-width: none;
    margin-top: 12px;
    left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
  }
  .carousel__track {
    display: flex;
    gap: 18px;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    scroll-behavior: auto !important;
  }

  .carousel__item {
    flex: 0 0 clamp(260px, 26vw, 440px);
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    position: relative;
    border: 1px solid color-mix(in oklab, var(--color-primary) 26%, transparent);
    overflow: hidden;
  }
  .carousel__item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: translateZ(0);
  }

  /* Mobile overrides removed to keep marquee animation */
  /*
  @media (max-width: 768px) {
    .carousel {
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      left: auto;
      transform: none;
      overflow-x: auto;
      padding-inline: 16px;
      scroll-snap-type: x mandatory;
    }
    .carousel__track {
      gap: 14px;
      padding-bottom: 6px;
      width: max-content;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
    }
    .carousel__item {
      scroll-snap-align: center;
    }
    .carousel::-webkit-scrollbar {
      display: none;
    }
    .carousel {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  }
  */

  @supports not (color: color-mix(in oklab, black 50%, white)) {
    .pill {
      background: rgba(243, 244, 246, 0.6);
    }
    .carousel__item {
      border-color: rgba(99, 102, 241, 0.26);
    }
  }

  /* Pantallas bajas en horizontal (p. ej. 844×390, 800×360): etiqueta,
     título, subtítulo y botón visibles sin hacer scroll. El header se
     compacta a 68px en Header.astro. */
  @media (orientation: landscape) and (max-height: 500px) {
    .hero {
      padding-top: 76px;
      min-height: auto;
    }

    .pill {
      margin-bottom: 8px;
    }

    .hero__title {
      /* mínimo de la escala (36px) */
      font-size: min(var(--text-display), 2.25rem);
    }

    .hero__subtitle {
      margin: 10px auto 14px;
    }

    .hero__actions {
      margin-bottom: 20px;
    }
  }
</style>
