---
import Ribbon from "../ui/Ribbon.astro";
---

<section class="discount-banner">
  <Ribbon class="ribbon--top" />
  <Ribbon class="ribbon--bottom" reverse />
</section>

<style>
  .discount-banner {
    position: relative;
    padding: 40px 0;
    margin-top: -100px;
    margin-bottom: -100px;
    overflow: hidden;
    background-color: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
    width: 100%;
    z-index: 30;
  }

  .discount-banner :global(.ribbon) {
    height: 80px;
  }

  .discount-banner :global(.ribbon--top) {
    transform: rotate(-3deg);
    z-index: 10;
  }

  .discount-banner :global(.ribbon--bottom) {
    transform: rotate(3deg);
    z-index: 20;
  }

  @media (max-width: 640px) {
    .discount-banner {
      padding: 80px 0;
      min-height: 200px;
    }

    .discount-banner :global(.ribbon) {
      height: 60px;
      width: 150%;
      left: -25%;
    }

    .discount-banner :global(.ribbon--top) {
      transform: rotate(-5deg);
    }

    .discount-banner :global(.ribbon--bottom) {
      transform: rotate(5deg);
    }
  }
</style>
