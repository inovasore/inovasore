---
// Bloque "SOLUCIONES A MEDIDA…" con relleno de texto ligado al scroll.
// "SIN LÍMITES." toma el degradado de los títulos cuando su línea termina
// de rellenarse (el script marca la línea con data-filled).
// Extraído de Services.astro sin cambios de diseño ni de animación.
// Se usa en el inicio (tras ServicesScroll) y dentro de Services.astro (/servicios).
---

<div class="container scroll-reveal-container">
  <p class="scroll-reveal-text">
    <span
      class="scroll-line reveal"
      data-line="1"
      style="--reveal-delay:.08s;--reveal-duration:.55s;--reveal-distance:14px"
      >SOLUCIONES A MEDIDA</span
    >{" "}
    <span
      class="scroll-line reveal"
      data-line="2"
      style="--reveal-delay:.16s;--reveal-duration:.55s;--reveal-distance:14px"
      >PARA QUE TU NEGOCIO</span
    >{" "}
    <span
      class="scroll-line reveal"
      data-line="3"
      style="--reveal-delay:.24s;--reveal-duration:.55s;--reveal-distance:14px"
      >AVANCE <span class="highlight">SIN LÍMITES.</span></span
    >
  </p>
</div>

<script>
  function initScrollReveal() {
    const lines = document.querySelectorAll(
      ".scroll-line",
    ) as NodeListOf<HTMLElement>;
    if (!lines.length) return;

    const updateScroll = () => {
      const container = document.querySelector(".scroll-reveal-container");
      if (!container) return;

      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Calcular progreso general (0 a 1)
      const start = windowHeight * 0.85;
      const end = windowHeight * 0.25;

      let overallProgress = 0;
      if (rect.top < start) {
        overallProgress = 1 - (rect.top - end) / (start - end);
      }
      overallProgress = Math.min(Math.max(overallProgress, 0), 1);

      // Dividir el progreso entre las 3 líneas
      // Línea 1: 0% - 33%, Línea 2: 33% - 66%, Línea 3: 66% - 100%
      lines.forEach((line, index) => {
        const lineStart = index / lines.length;
        const lineEnd = (index + 1) / lines.length;

        let lineProgress = 0;
        if (overallProgress > lineStart) {
          lineProgress = (overallProgress - lineStart) / (lineEnd - lineStart);
        }
        lineProgress = Math.min(Math.max(lineProgress, 0), 1);

        line.style.setProperty("--line-progress", `${lineProgress * 100}%`);
        line.toggleAttribute("data-filled", lineProgress >= 1);
      });
    };

    window.addEventListener("scroll", updateScroll, { passive: true });
    updateScroll();
  }

  document.addEventListener("astro:page-load", initScrollReveal);
  initScrollReveal();
</script>

<style>
  .scroll-reveal-container {
    margin-top: clamp(48px, 9vh, 80px);
    margin-bottom: clamp(32px, 6vh, 48px);
    display: flex;
    justify-content: center;
  }

  /* Excepción a la escala tipográfica: frase decorativa a gran tamaño.
     Cada línea ocupa ~70% del contenedor en escritorio y cabe en un
     renglón a 375px. */
  .scroll-reveal-text {
    font-size: clamp(1.75rem, 0.6rem + 4.9vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 700;
    text-align: center;
    max-width: 100%;
    margin: 0;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
  }

  .scroll-line {
    display: block;
    --line-progress: 0%;
    background: linear-gradient(
      to right,
      #ffffff 0%,
      #ffffff var(--line-progress),
      rgba(255, 255, 255, 0.15) var(--line-progress),
      rgba(255, 255, 255, 0.15) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }

  /* El degradado entra de izquierda a derecha al completarse la línea;
     antes, el texto muestra el relleno blanco de la línea. */
  .scroll-line .highlight {
    background: linear-gradient(90deg, #26d2f8, #23b2ff, #0973e1 70%, #3b5bff)
      0 0 / 0% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-size 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scroll-line[data-filled] .highlight {
    background-size: 100% 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line .highlight {
      transition: none;
    }
  }
</style>
