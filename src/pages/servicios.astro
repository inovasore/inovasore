---
import PageLayout from "../layouts/PageLayout.astro";
import Services from "../components/sections/Services.astro";
import TechSection from "../components/sections/TechSection.astro";
import Process from "../components/sections/Process.astro";
import Testimonials from "../components/sections/Testimonials.astro";
---

<PageLayout
  title="Servicios | Novasore"
  description="Explora nuestros servicios principales: diseño web, tiendas online, landing pages, SEO técnico y soporte continuo."
  class="services-page"
>
  <Services offsetTop="clamp(82px, 18vw, 120px)" />
  <TechSection />
  <Process />
  <Testimonials />
</PageLayout>

<style>
  /* Espaciado propio de las secciones en esta página. El contenedor lo
     pinta PageLayout, por eso el selector es global (.page-bg.services-page
     conserva la misma especificidad que tenía antes). */
  :global(.page-bg.services-page .process) {
    padding-top: clamp(80px, 14vh, 130px);
  }

  :global(.page-bg.services-page .testimonials) {
    padding-top: clamp(50px, 8vh, 80px);
  }
</style>
