---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import WhyUs from "../components/sections/WhyUs.astro";
import ServicesScroll from "../components/sections/ServicesScroll.astro";
import PresenceStatement from "../components/sections/PresenceStatement.astro";
import Process from "../components/sections/Process.astro";
import Projects from "../components/sections/Projects.astro";
import CTA from "../components/sections/CTA.astro";
import DiscountBanner from "../components/sections/DiscountBanner.astro";
import FAQ from "../components/sections/FAQ.astro";
import { faqs } from "../data/faqs";

// FAQ Schema para AEO (Answer Engine Optimization)
const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
});
---

<Layout
  title="Diseño, desarrollo web y automatización en Ambato | Novasore"
  description="Estudio de desarrollo web en Ambato: creamos páginas web, tiendas en línea, aplicaciones y chatbots a la medida de tu negocio, pensados para crecer."
  ogTitle="Diseño, desarrollo web y automatización en Ambato | Novasore"
  ogDescription="Estudio de desarrollo web en Ambato: creamos páginas web, tiendas en línea, aplicaciones y chatbots a la medida de tu negocio, pensados para crecer."
  ogImage="/Web-Inovasore.webp"
>
  <Hero />
  <!-- Fuera de .shared-bg-wrapper: su overflow:hidden rompería el sticky -->
  <ServicesScroll />
  <div class="shared-bg-wrapper">
    <PresenceStatement />
  </div>
  <Process />
  <!-- Grilla de fondo desactivada en el inicio -->
  <Projects showGrid={false} />
  <CTA />
  <DiscountBanner />
  <WhyUs />
  <FAQ />

  <!-- FAQ Schema para AEO (Answer Engine Optimization) -->
  <script type="application/ld+json" set:html={faqSchema} />
</Layout>

<style>
  .shared-bg-wrapper {
    position: relative;
    background-color: var(--color-bg);
    /* clip (no hidden): no crea un contenedor de scroll, así funciona
       animation-timeline: view(). flow-root conserva el BFC de hidden. */
    overflow: clip;
    display: flow-root;
  }

  .shared-bg-wrapper > :global(*) {
    position: relative;
    z-index: 1;
  }

  /* Extra padding for FAQ component */
  :global(.faq) {
    padding-top: clamp(80px, 12vh, 120px) !important;
    padding-bottom: clamp(100px, 14vh, 140px) !important;
  }

  /* Reduce padding for Process component in home page */
  :global(.process) {
    padding-top: clamp(30px, 4vh, 50px) !important;
  }
</style>
