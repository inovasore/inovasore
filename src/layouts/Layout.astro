---
// Fuente del sitio alojada localmente (Google Fonts vía Fontsource): sin
// conexión a terceros antes de mostrar el texto.
import "@fontsource-variable/instrument-sans";
import instrumentSansLatin from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SEO from "../components/seo/SEO.astro";

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title = "Diseño y Desarrollo de Páginas Web en Ambato: E-commerce, Landing Pages y Tiendas Online. | Novasore",
  description = "Creamos páginas web y tiendas online que convierten: landing pages, e-commerce, webs institucionales y plataformas educativas. Diseño moderno, SEO técnico y alto rendimiento en Ambato y todo Ecuador.",
  ogTitle = "Desarrollo web y tiendas online que convierten | Novasore",
  ogDescription = "Impulsa tu presencia digital con sitios rápidos, seguros y optimizados: landing pages, e-commerce, webs institucionales y plataformas educativas. Diseño, SEO técnico y performance para atraer y vender más.",
  ogImage = "/Web-Inovasore.webp",
} = Astro.props;

const pathname = Astro.url?.pathname ?? "/";
const materialHref =
  "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24..48,600,1,0&display=swap";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- Antes del primer pintado: habilita las entradas .reveal (sin JS no se ocultan) -->
    <script is:inline>
      if ("IntersectionObserver" in window) document.documentElement.classList.add("js-reveal");
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <SEO
      title={title}
      description={description}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
    />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/Icono.svg" />
    <meta name="theme-color" content="#000000" />

    <!-- Instrument Sans (local): precarga del subconjunto latino -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={instrumentSansLatin}
      crossorigin
    />

    <!-- Material Symbols (Google Icons) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={materialHref} />
    <link
      id="font-material"
      rel="stylesheet"
      href={materialHref}
      media="print"
    />
    <noscript><link rel="stylesheet" href={materialHref} /></noscript>

    <script is:inline>
      (() => {
        const enableFont = (id) => {
          const el = document.getElementById(id);
          if (!(el instanceof HTMLLinkElement) || el.media !== "print") return;
          el.addEventListener(
            "load",
            () => {
              el.media = "all";
            },
            { once: true },
          );
        };
        enableFont("font-material");
      })();
    </script>

    {
      pathname === "/" && (
        <>
          <link
            rel="preload"
            as="image"
            href="/Vectorbg.svg"
            fetchpriority="high"
          />
        </>
      )
    }
  </head>

  <body id="top">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- Disparador de .reveal: solo añade .is-in al entrar en pantalla.
         La animación es CSS (global.css), la misma del hero. -->
    <script is:inline>
      (() => {
        if (!document.documentElement.classList.contains("js-reveal")) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
